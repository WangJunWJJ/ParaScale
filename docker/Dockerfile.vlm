FROM parascale-hf:cu121-torch24-transformers444

COPY .wheelhouse_vlm /tmp/parascale-wheelhouse-vlm
RUN python3 -m pip install --no-cache-dir --no-index \
    --find-links=/tmp/parascale-wheelhouse-vlm \
    transformers==4.51.3 \
    tokenizers==0.21.4 \
    peft==0.14.0 \
    && rm -rf /tmp/parascale-wheelhouse-vlm
