{
  "schema_version": 1,
  "parascale": {
    "training_backend": "native",
    "precision": "fp32",
    "quantization": {
      "enabled": true,
      "mode": "${PARASCALE_COMPRESSION_MODE}",
      "bits": 8,
      "per_channel": true,
      "quantize_activations": false,
      "calib_batches": 1,
      "exclude_modules": ["lm_head"]
    }
  },
  "model": {
    "pretrained_model_name_or_path": "${PARASCALE_MODEL}",
    "attention_backend": "sdpa",
    "activation_checkpointing": false
  },
  "data": {
    "type": "token_corpus",
    "path": "${PARASCALE_TOKEN_CORPUS}",
    "batch_size": 1,
    "sequence_length": 128,
    "seed": 42,
    "shuffle": false,
    "repeat": true,
    "num_workers": 0
  },
  "optimizer": {"type": "adamw", "lr": 0.00001, "weight_decay": 0.01},
  "training": {
    "workload": "causal_lm",
    "seed": 42,
    "max_steps": 16,
    "checkpoint_dir": "${PARASCALE_RUN_DIR}/checkpoints",
    "quantized_output": "${PARASCALE_ARTIFACT}"
  },
  "runtime": {"accelerator": "cuda", "device": "cuda:0", "run_dir": "${PARASCALE_RUN_DIR}"}
}
