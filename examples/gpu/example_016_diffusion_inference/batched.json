{
  "schema_version": 1,
  "model": {"pretrained_model_name_or_path": "${PARASCALE_MODEL}"},
  "data": {"type": "prompts_jsonl", "path": "${PARASCALE_PROMPTS}"},
  "runtime": {"device": "cuda:0", "run_dir": "${PARASCALE_RUN_DIR}"},
  "inference": {
    "workload": "diffusion",
    "output_dir": "${PARASCALE_RUN_DIR}/images",
    "precision": "fp16",
    "batch_size": 8,
    "height": 512,
    "width": 512,
    "num_inference_steps": 30,
    "guidance_scale": 7.5,
    "seed": 42,
    "warmup_steps": 1,
    "compile_mode": "off"
  }
}
