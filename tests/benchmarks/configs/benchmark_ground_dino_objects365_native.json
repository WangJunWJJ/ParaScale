    "label_dir": "/dataset/cache/objects365_tiny_yolo/labels",
    "batch_size": 1,
    "image_size": 640,
    "num_samples": 64,
    "num_workers": 2,
    "pin_memory": true,
    "prefetch_factor": 2,
    "persistent_workers": true,
    "tensor_cache": true,
    "tensor_cache_dir": "runs/cache/ground_dino_objects365_tensor"
  },
  "optimizer": {
    "lr": 0.00001
  },
  "runtime": {
    "device": "auto"
  }
}
