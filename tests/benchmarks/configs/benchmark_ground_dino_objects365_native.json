{
  "parascale": {
    "task_type": "vision",
    "model_family": "grounding_dino",
    "target_scale": "single_node",
    "optimize_for": "throughput",
    "training_backend": "native",
    "batch_size": 1,
    "precision": "fp32",
    "dataloader_num_workers": 2,
    "dataloader_pin_memory": true,
    "dataloader_prefetch_factor": 2,
    "dataloader_persistent_workers": true,
    "tensor_cache": true,
    "tensor_cache_dir": "runs/cache/ground_dino_objects365_tensor"
  },
  "training": {
    "workload": "ground_dino",
    "max_steps": 10,
    "benchmark_steps": 10,
    "warmup_steps": 2,
    "batch_size": 1,
    "checkpoint_interval": 10,
    "checkpoint_dir": "runs/benchmarks/ground_dino_objects365/native_ckpt",
    "skip_final_checkpoint": false
  },
  "model": {
    "path": "IDEA-Research/grounding-dino-tiny",
