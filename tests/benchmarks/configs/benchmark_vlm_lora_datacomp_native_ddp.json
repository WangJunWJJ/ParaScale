  "training": {
    "workload": "vlm_lora",
    "max_steps": 40,
    "benchmark_steps": 40,
    "warmup_steps": 5,
    "gradient_accumulation_steps": 1,
    "checkpoint_dir": "runs/benchmarks/vlm_lora_datacomp/native_ddp_ckpt",
    "checkpoint_interval": 999999,
