{
  "schema_version": 1,
  "parascale": {
    "task_type": "multimodal",
    "model_family": "clip",
    "target_scale": "single_node",
    "training_backend": "native_ddp",
    "precision": "fp32",
    "data_parallel_size": 4,
    "ddp_comm_hook": "none",
    "ddp_find_unused_parameters": true,
    "checkpoint_save_path": "/experiment/long-run-limits/checkpoints",
    "checkpoint_save_interval": 2
  },
  "task": {"type": "multimodal", "workload": "clip_contrastive"},
  "model": {
    "type": "hf_clip",
    "pretrained_model_name_or_path": "/assets/openai_clip-vit-base-patch32-pytorch"
  },
  "data": {
    "type": "datacomp_wds",
    "data_dir": "/experiment/datasets/flickr8k_from145/train",
    "streaming": true,
    "num_workers": 0,
    "text_length": 64
  },
  "optimizer": {"type": "adamw", "lr": 0.000001},
  "hardware_profile": {"num_gpus": 4, "gpus_per_node": 4},
  "distributed": {"nnodes": 1, "nproc_per_node": 4},
  "runtime": {"device": "cuda", "run_dir": "/experiment/long-run-limits/run"},
  "training": {
    "workload": "clip_contrastive",
    "batch_size": 8,
    "gradient_accumulation_steps": 1,
    "max_steps": 6,
    "checkpoint_interval": 2,
    "checkpoint_keep_last": 2,
    "metrics_history_limit": 3,
    "checkpoint_dir": "/experiment/long-run-limits/checkpoints",
    "seed": 42
  }
}
