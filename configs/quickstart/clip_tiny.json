    "gpu_memory": 1000000000,
    "available_memory": 900000000
  },
  "training": {
    "workload": "clip_contrastive",
    "max_steps": 2,
    "checkpoint_dir": "./runs/quickstart/clip_tiny",
    "checkpoint_interval": 1
  }
