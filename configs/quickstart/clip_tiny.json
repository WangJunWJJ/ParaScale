{
  "parascale": {
    "task_type": "multimodal",
    "model_family": "clip",
    "target_scale": "local",
    "optimize_for": "throughput",
    "training_backend": "native",
    "precision": "fp32",
    "batch_size": 4,
    "checkpoint_save_path": "./runs/quickstart/clip_tiny",
    "checkpoint_save_interval": 1
  },
  "task": {
    "type": "multimodal",
