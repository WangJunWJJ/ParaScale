{
  "schema_version": 1,
  "parascale": {
    "task_type": "multimodal",
    "model_family": "vlm_lora",
    "target_scale": "single_node",
    "optimize_for": "balanced",
    "training_backend": "native_ddp",
    "precision": "bf16",
    "data_parallel_size": 2,
    "ddp_gradient_as_bucket_view": true,
    "ddp_static_graph": false,
    "batch_size": 1,
    "gradient_accumulation_steps": 4,
    "enable_activation_checkpointing": true,
    "adapter_only_checkpoint": true,
    "dataloader_num_workers": 4,
    "dataloader_prefetch_factor": 4,
    "dataloader_persistent_workers": true,
    "dataloader_pin_memory": true,
    "device_prefetch": true,
    "checkpoint_save_path": "${PARASCALE_RUN_ROOT}/vlm_lora_small/checkpoints",
    "checkpoint_save_interval": 250
  },
  "task": {
    "type": "multimodal",
    "workload": "vlm_lora",
    "model_family": "llava_onevision",
    "modalities": ["image", "text"],
    "objective": "supervised_vlm_lora_finetune",
    "conversation_template": "llava_onevision",
    "response_template": "A concise visual description."
  },
  "model": {
    "type": "llava_onevision_lora",
    "family": "llava_onevision",
    "pretrained_model_name_or_path": "${PARASCALE_MODEL_ROOT}/llava-onevision-qwen2-0.5b-ov-hf",
    "image_size": 224,
    "patch_size": 14,
    "vocab_size": 151936,
    "text_length": 2048,
    "embed_dim": 896,
    "activation_checkpointing": true
  },
  "data": {
    "type": "datacomp_wds",
    "data_dir": "${PARASCALE_DATA_ROOT}/datacomp_subsets/final/datacomp_10k_wds",
    "streaming": true,
    "num_workers": 4,
    "prefetch_factor": 4,
    "persistent_workers": true,
    "pin_memory": true,
    "num_samples": 4000,
    "batch_size": 1,
    "image_size": 224,
    "text_length": 2048,
    "preprocess_in_workers": true,
    "pipeline_cache": true,
    "pipeline_cache_dir": "${PARASCALE_RUN_ROOT}/vlm_lora_small/cache",
    "pipeline_cache_max_entries": 4096,
    "pipeline_cache_max_bytes": 20000000000,
    "prompt_template_cache": true,
    "prompt_template_cache_dir": "${PARASCALE_RUN_ROOT}/vlm_lora_small/prompt_cache"
  },
  "lora": {
    "rank": 8,
    "alpha": 16.0,
    "dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "use_peft": true,
    "train_lm_head": false
  },
  "optimizer": {"type": "adamw", "lr": 0.0001},
  "model_profile": {
    "total_params": 500000000,
    "trainable_params": 5000000,
    "total_memory": 3000000000,
    "num_layers": 24,
    "model_type": "llava_onevision_lora"
  },
  "hardware_profile": {
    "num_gpus": 2,
    "gpus_per_node": 2,
    "gpu_memory": 24000000000,
    "available_memory": 20000000000
  },
  "runtime": {
    "run_dir": "${PARASCALE_RUN_ROOT}/vlm_lora_small"
  },
  "training": {
    "workload": "vlm_lora",
    "max_steps": 500,
    "benchmark_steps": 500,
    "warmup_steps": 20,
    "gradient_accumulation_steps": 4,
    "checkpoint_dir": "${PARASCALE_RUN_ROOT}/vlm_lora_small/checkpoints",
    "checkpoint_interval": 250,
    "skip_final_checkpoint": false,
    "validate_resume": true
  }
}
