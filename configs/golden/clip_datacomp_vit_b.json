{
  "parascale": {
    "task_type": "multimodal",
    "model_family": "clip",
    "target_scale": "single_node",
    "optimize_for": "throughput",
    "training_backend": "native_ddp",
    "precision": "bf16",
    "data_parallel_size": 2,
    "batch_size": 32,
    "dataloader_num_workers": 4,
    "dataloader_prefetch_factor": 4,
    "dataloader_persistent_workers": true,
    "dataloader_pin_memory": true,
    "device_prefetch": true,
    "checkpoint_save_path": "${PARASCALE_RUN_ROOT}/clip_datacomp_vit_b/checkpoints",
    "checkpoint_save_interval": 250
  },
  "task": {
    "type": "multimodal",
    "workload": "clip_contrastive",
    "model_family": "clip",
    "modalities": ["text", "image"],
    "objective": "image_text_contrastive",
    "temperature": 0.07,
    "symmetric_loss": true
  },
  "model": {
    "type": "hf_clip",
    "pretrained_model_name_or_path": "${PARASCALE_MODEL_ROOT}/openai_clip-vit-base-patch32",
    "image_size": 224,
    "channels": 3,
    "patch_size": 32,
    "vocab_size": 49408,
    "text_length": 64,
    "embed_dim": 512,
    "activation_checkpointing": false
  },
  "data": {
    "type": "datacomp_wds",
    "streaming": true,
    "data_dir": "${PARASCALE_DATA_ROOT}/datacomp_subsets/final/datacomp_10k_wds",
    "num_samples": 64000,
    "batch_size": 32,
    "num_workers": 4,
    "prefetch_factor": 4,
    "persistent_workers": true,
    "pin_memory": true,
    "image_size": 224,
    "text_length": 64
  },
  "optimizer": {"type": "adamw", "lr": 0.000001},
  "model_profile": {
    "total_params": 151000000,
    "total_memory": 1208000000,
    "num_layers": 24,
    "model_type": "hf_clip"
  },
  "hardware_profile": {
    "num_gpus": 2,
    "gpus_per_node": 2,
    "gpu_memory": 24000000000,
    "available_memory": 20000000000
  },
  "runtime": {
    "run_dir": "${PARASCALE_RUN_ROOT}/clip_datacomp_vit_b"
  },
  "training": {
    "workload": "clip_contrastive",
    "max_steps": 500,
    "benchmark_steps": 500,
    "warmup_steps": 20,
    "checkpoint_dir": "${PARASCALE_RUN_ROOT}/clip_datacomp_vit_b/checkpoints",
    "checkpoint_interval": 250,
    "skip_final_checkpoint": false,
    "validate_resume": true
  }
}
